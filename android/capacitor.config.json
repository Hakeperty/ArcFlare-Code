{
  "appId": "net.arcflare.app",
  "appName": "ArcFlare",
  "loggingBehavior": "none",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#0b0b0a",
    "minWebViewVersion": 133
  },
  "server": {
    "androidScheme": "https",
    "errorPath": "webview-error.html"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": false
    },
    "CapacitorCookies": {
      "enabled": false
    }
  }
}
