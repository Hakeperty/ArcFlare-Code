<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- allowBackup=false and both rule files below: nothing leaves the phone through backup or device transfer. -->
    <!-- networkSecurityConfig: cleartext is permitted for native requests to the hub's LAN mailbox only in practice (see the file); the WebView cannot navigate to anything but https://localhost. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- The only exported component: the launcher activity, which also receives arcflare://pair links. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- arcflare://pair only. No https app links, so no web page can ever hand the app a link. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="arcflare" android:host="pair" />
            </intent-filter>

        </activity>

        <!-- The template's FileProvider is removed: nothing in this app shares files. -->
    </application>

    <!-- Network only. No camera, storage, location or any other permission. -->
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
